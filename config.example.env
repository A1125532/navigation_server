# Copy to .env or config.env and fill values before running the server.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Local safe-route Dijkstra graph source. These files are read first.
LOCAL_NODES_PATH=data/nuk_nodes_new.json
LOCAL_EDGES_PATH=data/nuk_edges_new.json
LOCAL_ENVIRONMENT_POINTS_PATH=data/environment_points.json

# Firebase fallback graph source. Google Directions is not used for routing.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_NODES_COLLECTION=nuk_nodes_new
FIREBASE_EDGES_COLLECTION=nuk_edges_new
FIREBASE_ENVIRONMENT_COLLECTIONS=safe_places,nuk

# YOLO live video object detection.
YOLO_ENABLED=true
YOLO_MODEL=yolov8n.pt
